---
import type { Product } from '../lib/products/queries';
import { formatMoney } from '../lib/payments';

interface Props {
  listing: Product;
  index: number;
  commerceEnabled: boolean;
}

const { listing, index, commerceEnabled } = Astro.props;

const typeLabel: Record<Product['type'], string> = {
  beat: 'Beat',
  stems: 'Stems',
  sample: 'Sample',
  pack: 'Pack',
};
---

<a href={`/shop/listings/${listing.slug}`} class="rack-row group" aria-label={listing.title}>
  <span class="label [grid-area:idx]">{String(index + 1).padStart(2, '0')}</span>

  <div class="min-w-0 [grid-area:title]">
    <h3 class="truncate text-base">{listing.title}</h3>
    <span class="label">{typeLabel[listing.type]} · {listing.formats}</span>
  </div>

  <span class="lcd [grid-area:lcd]">
    {listing.bpm ? (
      <>
        <span class="seg">{listing.bpm}</span>
        <span class="unit">BPM</span>
      </>
    ) : (
      <span class="seg text-segment-off">&mdash;</span>
    )}
  </span>

  <span class="label [grid-area:meta]">{listing.musicalKey ?? '—'}</span>

  {commerceEnabled ? (
    <span class="lcd [grid-area:price]">
      <span class="seg">{formatMoney(listing.priceCents, listing.currency)}</span>
    </span>
  ) : (
    listing.duration && (
      <span class="lcd [grid-area:price]">
        <span class="seg">{listing.duration}</span>
      </span>
    )
  )}

  <span class="arrow max-[900px]:hidden font-mono text-ink-dim group-hover:text-ink">&rarr;</span>
</a>
