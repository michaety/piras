---
import { env } from 'cloudflare:workers';
import StoreHeader from '../components/StoreHeader';
import RackRow from '../components/RackRow.astro';
import '../styles/globals.css';
import { PRODUCER_NAME } from '../lib/site';
import { listPublished, type ProductType } from '../lib/products/queries';
import { getCartCountFromRequest } from '../lib/cart/items';

const FILTERS: Array<{ label: string; type: ProductType | null }> = [
  { label: 'All', type: null },
  { label: 'Beats', type: 'beat' },
  { label: 'Stems', type: 'stems' },
  { label: 'Samples', type: 'sample' },
  { label: 'Packs', type: 'pack' },
];

const VALID_TYPES: readonly ProductType[] = ['beat', 'stems', 'sample', 'pack'];
const requestedType = Astro.url.searchParams.get('type');
const activeType =
  requestedType && (VALID_TYPES as readonly string[]).includes(requestedType)
    ? (requestedType as ProductType)
    : null;

// The filter is applied in the query itself, not by filtering an
// already-fetched list — a draft/archived row is never in this result
// set to begin with, filter or no filter.
const listings = await listPublished(env.DB, activeType ? { type: activeType } : {});
const cartCount = await getCartCountFromRequest(env.DB, Astro.request);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Shop — {PRODUCER_NAME}</title>
  </head>
  <body>
    <StoreHeader currentPath={Astro.url.pathname} cartCount={cartCount} />

    <main>
      <div class="groove flex flex-wrap gap-2 px-gutter py-4">
        {FILTERS.map((filter) => (
          <a
            href={filter.type ? `/shop?type=${filter.type}` : '/shop'}
            data-active={activeType === filter.type}
            class={`key ${activeType === filter.type ? 'bg-recess' : ''}`}
          >
            {filter.label}
          </a>
        ))}
      </div>

      {listings.length === 0 ? (
        <p class="label px-gutter py-8">
          {activeType ? 'No listings match this filter.' : 'Nothing in the shop yet — check back soon.'}
        </p>
      ) : (
        listings.map((listing, index) => <RackRow listing={listing} index={index} />)
      )}
    </main>
  </body>
</html>
