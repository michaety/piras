---
import { env } from 'cloudflare:workers';
import StoreHeader from '../components/StoreHeader';
import RackRow from '../components/RackRow.astro';
import '../styles/globals.css';
import { PRODUCER_NAME, SITE_DESCRIPTION } from '../lib/site';
import { listFeatured } from '../lib/products/queries';
import { getCartCountFromRequest } from '../lib/cart/items';

const featured = await listFeatured(env.DB);
const cartCount = await getCartCountFromRequest(env.DB, Astro.request);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={SITE_DESCRIPTION} />
    <title>{PRODUCER_NAME}</title>
  </head>
  <body>
    <StoreHeader currentPath={Astro.url.pathname} cartCount={cartCount} />

    <main>
      <section class="px-gutter py-16">
        <h1 class="max-w-2xl">{PRODUCER_NAME}</h1>
        <p class="mt-4 label normal-case text-ink-dim">{SITE_DESCRIPTION}</p>
        <a href="/shop" class="key mt-8 inline-block">Browse the shop</a>
      </section>

      {featured.length > 0 && (
        <section>
          <h2 class="label px-gutter py-2">Featured</h2>
          {featured.map((listing, index) => <RackRow listing={listing} index={index} />)}
        </section>
      )}
    </main>
  </body>
</html>
