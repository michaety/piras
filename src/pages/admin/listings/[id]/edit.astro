---
import { env } from 'cloudflare:workers';
import '../../../../styles/globals.css';
import { PRODUCER_NAME } from '../../../../lib/site';
import { csrfCookie, generateCsrfToken } from '../../../../lib/admin/csrf';
import ListingForm, { type ListingFormValues } from '../../../../components/admin/ListingForm';
import { getById } from '../../../../lib/products/queries';

const { id } = Astro.params as { id: string };

const product = await getById(env.DB, id);

if (!product) {
  return new Response(null, { status: 404 });
}

const initial: ListingFormValues = {
  title: product.title,
  type: product.type,
  description: product.description,
  price: (product.priceCents / 100).toFixed(2),
  bpm: product.bpm ? String(product.bpm) : '',
  musical_key: product.musicalKey ?? '',
  duration: product.duration ?? '',
  formats: product.formats,
  licence: product.licence,
  featured: product.featured,
};

function filenameFromKey(key: string | null): { filename: string } | undefined {
  if (!key) return undefined;
  return { filename: key.split('/').pop() ?? key };
}

const existingFiles = {
  cover: filenameFromKey(product.coverKey),
  preview: filenameFromKey(product.previewKey),
  deliverable: filenameFromKey(product.deliverableKey),
};

const csrfToken = generateCsrfToken();
Astro.response.headers.append('Set-Cookie', csrfCookie(csrfToken));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Edit {product.title} — Admin — {PRODUCER_NAME}</title>
  </head>
  <body>
    <main class="px-gutter py-12">
      <h1>Edit listing</h1>
      <ListingForm
        client:load
        csrfToken={csrfToken}
        mode="edit"
        listingId={product.id}
        initial={initial}
        existingFiles={existingFiles}
      />
    </main>
  </body>
</html>
