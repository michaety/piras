---
import { env } from 'cloudflare:workers';
import StoreHeader from '../components/StoreHeader';
import '../styles/globals.css';
import { PRODUCER_NAME } from '../lib/site';
import { getCartCountFromRequest } from '../lib/cart/items';

const cartCount = await getCartCountFromRequest(env.DB, Astro.request);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>About — {PRODUCER_NAME}</title>
  </head>
  <body>
    <StoreHeader currentPath={Astro.url.pathname} cartCount={cartCount} />

    <main class="px-gutter py-16">
      <h1>About</h1>
      <p class="mt-4 max-w-md text-ink-dim">
        {PRODUCER_NAME} makes beats, stems, and sample packs, sold direct — no
        marketplace, no accounts, no subscriptions.
      </p>
    </main>
  </body>
</html>
