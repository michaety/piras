---
import { env } from 'cloudflare:workers';
import StoreHeader from '../../../components/StoreHeader';
import '../../../styles/globals.css';
import { PRODUCER_NAME } from '../../../lib/site';
import { listings } from '../../../lib/fixtures/listings';
import { formatMoney } from '../../../lib/payments';
import { getCartCountFromRequest } from '../../../lib/cart/items';
import { csrfCookie, generateCsrfToken } from '../../../lib/admin/csrf';

const { id } = Astro.params as { id: string };
const listing = listings.find((l) => l.id === id);

if (!listing) {
  return new Response(null, { status: 404 });
}

const typeLabel: Record<typeof listing.type, string> = {
  beat: 'Beat',
  stems: 'Stems',
  sample: 'Sample',
  pack: 'Pack',
};

const cartCount = await getCartCountFromRequest(env.DB, Astro.request);
const csrfToken = generateCsrfToken();
Astro.response.headers.append('Set-Cookie', csrfCookie(csrfToken));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{listing.title} — {PRODUCER_NAME}</title>
  </head>
  <body>
    <StoreHeader currentPath={Astro.url.pathname} cartCount={cartCount} />

    <main class="px-gutter py-12">
      <div class="flex flex-col gap-8 sm:flex-row">
        {listing.cover_url && (
          <div class="w-full max-w-xs flex-none self-start border border-glass-edge bg-recess p-2 sm:w-56">
            <img src={listing.cover_url} alt="" width="220" height="220" class="w-full" />
          </div>
        )}

        <div class="min-w-0 flex-1">
          <span class="label">{typeLabel[listing.type]} · {listing.formats} · {listing.licence}</span>
          <h1 class="mt-2">{listing.title}</h1>
          <p class="mt-4 text-ink-dim">{listing.description}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <span class="lcd">
              {listing.bpm ? (
                <>
                  <span class="seg">{listing.bpm}</span>
                  <span class="unit">BPM</span>
                </>
              ) : (
                <span class="seg text-segment-off">&mdash;</span>
              )}
            </span>
            <span class="lcd">
              <span class="seg">{listing.musical_key ?? '—'}</span>
            </span>
            {listing.duration && (
              <span class="lcd">
                <span class="seg">{listing.duration}</span>
              </span>
            )}
            <span class="lcd">
              <span class="seg">{formatMoney(listing.price_cents, listing.currency)}</span>
            </span>
          </div>

          {listing.preview_url && (
            <div class="mt-6 flex items-center gap-3">
              <button type="button" class="key" id="preview-toggle" data-state="paused">
                Play preview
              </button>
              <audio id="preview-audio" preload="none" src={listing.preview_url}></audio>
            </div>
          )}

          {listing.tracklist && (
            <table class="groove mt-10 w-full max-w-xl">
              <tbody>
                {listing.tracklist.map((track) => (
                  <tr class="groove">
                    <td class="label py-2 pr-4">{String(track.position).padStart(2, '0')}</td>
                    <td class="py-2">{track.title}</td>
                    <td class="label py-2 pl-4 text-right">{track.duration}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}

          <form method="POST" action="/api/cart/add" class="mt-10">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="productId" value={listing.id} />
            <button type="submit" class="key self-start">
              Add to cart — {formatMoney(listing.price_cents, listing.currency)}
            </button>
          </form>
        </div>
      </div>
    </main>

    <script>
      const button = document.getElementById('preview-toggle');
      const audio = document.getElementById('preview-audio');

      if (button && audio instanceof HTMLAudioElement) {
        button.addEventListener('click', () => {
          if (audio.paused) {
            audio.play();
            button.textContent = 'Stop preview';
          } else {
            audio.pause();
            audio.currentTime = 0;
            button.textContent = 'Play preview';
          }
        });

        audio.addEventListener('ended', () => {
          button.textContent = 'Play preview';
        });
      }
    </script>
  </body>
</html>
