---
import { env } from 'cloudflare:workers';
import StoreHeader from '../../../components/StoreHeader';
import '../../../styles/globals.css';
import { PRODUCER_NAME, isCommerceEnabled } from '../../../lib/site';
import { getPublishedBySlug, getTracks } from '../../../lib/products/queries';
import { formatMoney } from '../../../lib/payments';
import { getCartCountFromRequest } from '../../../lib/cart/items';
import { csrfCookie, generateCsrfToken } from '../../../lib/admin/csrf';

const { slug } = Astro.params as { slug: string };

// status = 'published' is enforced inside getPublishedBySlug's query, not
// checked here after the fact — a draft or archived row is never
// returned, so there's no "found but hidden" branch to get wrong.
const listing = await getPublishedBySlug(env.DB, slug);

if (!listing) {
  return new Response(null, { status: 404 });
}

const tracks = await getTracks(env.DB, listing.id);

const typeLabel: Record<typeof listing.type, string> = {
  beat: 'Beat',
  stems: 'Stems',
  sample: 'Sample',
  pack: 'Pack',
};

const commerceEnabled = isCommerceEnabled(env.COMMERCE_ENABLED);
const cartCount = commerceEnabled ? await getCartCountFromRequest(env.DB, Astro.request) : 0;

// The CSRF cookie only needs to exist for the add-to-cart form, which
// only renders when commerce is on.
let csrfToken = '';
if (commerceEnabled) {
  csrfToken = generateCsrfToken();
  Astro.response.headers.append('Set-Cookie', csrfCookie(csrfToken));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{listing.title} — {PRODUCER_NAME}</title>
  </head>
  <body>
    <StoreHeader currentPath={Astro.url.pathname} commerceEnabled={commerceEnabled} cartCount={cartCount} />

    <main class="px-gutter py-12">
      <div class="flex flex-col gap-8 sm:flex-row">
        {listing.coverKey && (
          <div class="w-full max-w-xs flex-none self-start border border-glass-edge bg-recess p-2 sm:w-56">
            <img src={`/media/${listing.coverKey}`} alt="" width="220" height="220" class="w-full" />
          </div>
        )}

        <div class="min-w-0 flex-1">
          <span class="label">{typeLabel[listing.type]} · {listing.formats} · {listing.licence}</span>
          <h1 class="mt-2">{listing.title}</h1>
          <p class="mt-4 text-ink-dim">{listing.description}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <span class="lcd">
              {listing.bpm ? (
                <>
                  <span class="seg">{listing.bpm}</span>
                  <span class="unit">BPM</span>
                </>
              ) : (
                <span class="seg text-segment-off">&mdash;</span>
              )}
            </span>
            <span class="lcd">
              <span class="seg">{listing.musicalKey ?? '—'}</span>
            </span>
            {listing.duration && (
              <span class="lcd">
                <span class="seg">{listing.duration}</span>
              </span>
            )}
            {commerceEnabled && (
              <span class="lcd">
                <span class="seg">{formatMoney(listing.priceCents, listing.currency)}</span>
              </span>
            )}
          </div>

          {listing.previewKey && (
            <div class="mt-6 flex items-center gap-3">
              <button type="button" class="key" id="preview-toggle" data-state="paused">
                Play preview
              </button>
              <audio id="preview-audio" preload="none" src={`/media/${listing.previewKey}`}></audio>
            </div>
          )}

          {tracks.length > 0 && (
            <table class="groove mt-10 w-full max-w-xl">
              <tbody>
                {tracks.map((track) => (
                  <tr class="groove">
                    <td class="label py-2 pr-4">{String(track.position).padStart(2, '0')}</td>
                    <td class="py-2">{track.title}</td>
                    <td class="label py-2 pl-4 text-right">{track.duration}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}

          {commerceEnabled ? (
            <form method="POST" action="/api/cart/add" class="mt-10">
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="productId" value={listing.id} />
              <button type="submit" class="key self-start">
                Add to cart — {formatMoney(listing.priceCents, listing.currency)}
              </button>
            </form>
          ) : (
            <a href={`/contact?ref=${listing.slug}`} class="key mt-10 inline-block">
              Enquire about this track
            </a>
          )}
        </div>
      </div>
    </main>

    <script>
      const button = document.getElementById('preview-toggle');
      const audio = document.getElementById('preview-audio');

      if (button && audio instanceof HTMLAudioElement) {
        button.addEventListener('click', () => {
          if (audio.paused) {
            audio.play();
            button.textContent = 'Stop preview';
          } else {
            audio.pause();
            audio.currentTime = 0;
            button.textContent = 'Play preview';
          }
        });

        audio.addEventListener('ended', () => {
          button.textContent = 'Play preview';
        });
      }
    </script>
  </body>
</html>
